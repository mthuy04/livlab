# Database (Neon / Postgres)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Google Gemini — powers LivLab Expert (/api/ai/expert), the AI budget
# suggestion (/api/ai/suggest) and the support chat (/api/ai/chat).
#
# SERVER-SIDE ONLY. Never prefix this with NEXT_PUBLIC_ — that would ship the
# key to every visitor's browser. It is read exclusively inside route handlers.
#
# LivLab targets the Gemini FREE TIER. Without this variable the AI features
# degrade gracefully and the rest of the app, Room Studio included, keeps working.
GEMINI_API_KEY=""

# Optional. Defaults to gemini-2.5-flash when unset.
GEMINI_MODEL="gemini-2.5-flash"
